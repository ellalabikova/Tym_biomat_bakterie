library(tidyverse)

df <- readr::read_csv("df_ready_for_correlation.csv")

if(! "bacteria_log_max" %in% names(df)) stop("Chybí bacteria_log_max")
if(! "stage.worse.cat" %in% names(df)) stop("Chybí stage.worse.cat")

# results
dir.create("results", showWarnings = FALSE)

# high_bacteria podle mediánu
thr <- median(df$bacteria_log_max, na.rm = TRUE)
df <- df %>%
  mutate(high_bacteria = bacteria_log_max > thr,
         high_bacteria = if_else(high_bacteria, "High", "Low"),
         high_bacteria = factor(high_bacteria, levels = c("Low","High")))

# kontrola
table(df$stage.worse.cat, useNA = "ifany")

# tabulka High vs stage.worse.cat
tab <- table(df$high_bacteria, df$stage.worse.cat, useNA = "ifany")
print(tab)

# Fisher
test_result <- NULL
try({
  test_result <- fisher.test(tab)
}, silent = TRUE)
if(is.null(test_result)) test_result <- chisq.test(tab)
print(test_result)

write_csv(as_tibble(as.data.frame(tab)), "results/high_vs_stage_worse_cat_table.csv")
capture.output(test_result, file = "results/high_vs_stage_worse_cat_test.txt")

plot_df <- df %>%
  filter(!is.na(stage.worse.cat)) %>%
  group_by(stage.worse.cat) %>%
  summarise(n = n(),
            n_high = sum(high_bacteria == "High", na.rm = TRUE)) %>%
  mutate(pct_high = n_high / n * 100) %>%
  arrange(stage.worse.cat)

# barplot
