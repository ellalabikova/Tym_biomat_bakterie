df <- readr::read_csv("df_ready_for_correlation.csv")


# převést G1/G2/G3 na čísla
df$grade_num <- as.numeric(factor(df$grade.worse, 
                                  levels = c("G1", "G2", "G3"),
                                  ordered = TRUE))

