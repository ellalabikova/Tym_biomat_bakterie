  geom_col(fill = "steelblue", alpha = 0.85) +
  geom_text(aes(label = paste0(round(pct_high,1), "% (n=", n, ")")), vjust = -0.5) +
  labs(x = "Stage (stage.worse.cat)", y = "% pacientů s high_bacteria",
       title = "Podíl pacientů s vysokou bakteriální zátěží podle stadia",
       subtitle = paste0("threshold = median (", round(thr, 3), ")")) +
  ylim(0, 100) +
  theme_classic(base_size = 13)

ggsave("results/high_vs_stage_worse_cat_barplot.png", p, width = 8, height = 5, dpi = 300)
write_csv(plot_df, "results/high_vs_stage_worse_cat_plotdata.csv")



