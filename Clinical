df <- readr::read_csv("df_ready_for_correlation.csv")

# vytvořit results/
dir.create("results", showWarnings = FALSE)

df <- df %>%
  mutate(
    spread = bacteria_log_max - bacteria_log_mean
  )

#vysoký / nízký spread podle mediánu
thr_spread <- median(df$spread, na.rm = TRUE)

df <- df %>%
  mutate(
    spread_group = if_else(spread > thr_spread, 
                           "High spread", 
                           "Low spread")
  )

#  uložit hodnoty do CSV
write_csv(df %>% select(ID, spread, spread_group),
          "results/spread_groups.csv")

# survival objekt
surv_obj <- Surv(time = df$rfs.time, event = df$rfs.event)

# Kaplan–Meier
fit <- survfit(surv_obj ~ spread_group, data = df)

# graf
p <- ggsurvplot(
  fit,
  data = df,
  risk.table = TRUE,
  pval = TRUE,
  conf.int = FALSE,
  palette = c("#1f77b4", "#d62728"),
  title = "RFS podle bacterial hotspot spread",
  xlab = "Days",
  ylab = "Relapse-free survival",
  legend.title = "",
  legend.labs = c("Low spread", "High spread")
)

ggsave("results/RFS_spread_KMplot.png", p$plot, width = 7, height = 6, dpi = 300)

# log-rank test
logrank <- survdiff(surv_obj ~ spread_group, data = df)
capture.output(logrank, file = "results/RFS_spread_logrank.txt")

# hazard ratio
hr <- logrank$obs[2] / logrank$exp[2]
capture.output(hr, file = "results/RFS_spread_HR.txt")


